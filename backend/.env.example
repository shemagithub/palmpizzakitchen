PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=palm_pizza
JWT_SECRET=palm_pizza_dev_secret_change_me
CORS_ORIGIN=http://localhost:3000
AUTO_SEED=1

# Public website URL (links inside verification emails)
APP_URL=http://localhost:3000

# Hosting mailbox SMTP (SSL/TLS, port 465)
SMTP_HOST=palmpizzakitchen.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Palm Pizza Kitchen <support@palmpizzakitchen.com>"

# Admin mailbox (info@) — IMAP 993 / SMTP 465. Do not commit real passwords.
IMAP_HOST=palmpizzakitchen.com
IMAP_PORT=993
IMAP_USER=info@palmpizzakitchen.com
IMAP_PASS=
MAILBOX_NAME="Palm Pizza Kitchen"
MAILBOX_SMTP_PORT=465

# Public backend URL (card payment return/callback)
BACKEND_PUBLIC_URL=http://localhost:4000

# XentriPay (Collections, Checkout, Payouts)
# Test: https://merchant.test.xentripay.com
# Live: https://xentripay.com
XENTRIPAY_API_BASE=https://xentripay.com
XENTRIPAY_API_KEY=
XENTRIPAY_WEBHOOK_SECRET=
XENTRIPAY_BUSINESS_EMAIL=
XENTRIPAY_BUSINESS_NAME="Palm Pizza Kitchen"
# Optional: pin a specific wallet id (otherwise matched by business name on /api/wallets)
# XENTRIPAY_WALLET_ID=
BUSINESS_OWNER_EMAIL=info@palmpizzakitchen.com
