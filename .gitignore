# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets; keep example templates)
.env
.env.*
!.env.example
!**/.env.example

# backend runtime
/backend/node_modules
/backend/uploads

# local deploy zips
*.zip

# editor / local
.qodo
.export-skip

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
